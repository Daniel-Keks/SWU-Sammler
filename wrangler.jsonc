{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swu-sammler",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swu-sammler-db",
      "database_id": "15efe94f-2dc4-4fb0-9226-93589a5d6865",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "daniel.grausnick@gmx.de"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
